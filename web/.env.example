# ECOMACROBIZ web (Next.js) — copy to .env.local and fill in. Never commit real values.

# Base URL of the Go API (server-only, never exposed to the browser).
# Leave empty to run without the API: Knowledge pages fall back to the bundled
# src/content/posts/posts.json and the contact form answers 503.
API_URL=http://localhost:18080

# Shared secret for POST /api/revalidate (header x-revalidate-secret).
# Must equal the API's REVALIDATE_SECRET; the API calls WEB_REVALIDATE_URL
# (= <site>/api/revalidate) after creating/updating/deleting a post.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Public canonical origin (used for metadataBase, canonical URLs, JSON-LD,
# share links). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.ecomacrobiz.com

# Public origin of the API's uploaded media (e.g. https://api.ecomacrobiz.com).
# Read at BUILD time: registers images.remotePatterns for <origin>/media/** so
# admin-uploaded covers are optimized by next/image. Empty = served unoptimized.
# Leave EMPTY for local dev: Next 16 refuses to optimize images from
# localhost/private IPs, so local API media is served unoptimized.
NEXT_PUBLIC_MEDIA_ORIGIN=

# Optional header holding the real visitor IP. Empty = right-most X-Forwarded-For.
# Railway staging (no Cloudflare): x-real-ip (set by Railway's edge).
# Production behind Cloudflare: cf-connecting-ip — and remove the web service's
# *.up.railway.app domain so nobody can bypass Cloudflare and spoof the header.
CLIENT_IP_HEADER=

# Production (Railway): see docs/DEPLOY.md for the full table. NEXT_PUBLIC_*
# are BUILD-time values (web/Dockerfile ARGs) — change them => redeploy.
# PORT is set by Railway (pin PORT=3000 so the API can reach
# http://web.railway.internal:3000/api/revalidate). API_URL is runtime-only.
