# ECOMACROBIZ API configuration. Copy to api/.env for local overrides.
# Every value below is a placeholder or a safe development default — never
# commit real secrets. Empty = feature disabled / default used.

# ---- server ---------------------------------------------------------------
# HTTP port (Railway injects PORT automatically).
PORT=18080
# development | production | test. production enforces COOKIE_SECURE=true and
# a non-empty CORS_ALLOWED_ORIGINS.
APP_ENV=development
# debug | info | warn | error (JSON logs on stdout).
LOG_LEVEL=info
# Graceful shutdown budget for in-flight requests/notifications.
SHUTDOWN_TIMEOUT=20s

# ---- database -------------------------------------------------------------
# Required. Compose DB from the host: port 55432.
DATABASE_URL=postgres://escoma:escoma-dev-only@localhost:55432/escoma?sslmode=disable
# Run embedded goose migrations ("up") on boot. Otherwise: `server migrate up`.
MIGRATE_ON_START=true

# ---- HTTP security --------------------------------------------------------
# Comma-separated exact origins allowed for CORS and for the admin Origin
# check (CSRF defence). No trailing slash, no wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Comma-separated IPs/CIDRs whose X-Forwarded-For is trusted for the client
# IP (rate limits, lead IP). Empty = trust nobody, use the TCP peer address.
# Railway: the web service reaches the API over the private network
# (IPv6 fd12::/16; environments created after 2025-10-16 also get IPv4):
#   TRUSTED_PROXIES=fd00::/8,10.0.0.0/8,100.64.0.0/10
TRUSTED_PROXIES=127.0.0.1,::1
# Send Strict-Transport-Security (enable only when served over HTTPS).
HSTS_ENABLED=false

# ---- admin session --------------------------------------------------------
# Secure flag on the escoma_admin cookie. Default true; false only for http
# localhost development.
COOKIE_SECURE=false
# Optional cookie Domain attribute (e.g. .ecomacrobiz.com). Empty = host-only.
COOKIE_DOMAIN=
# Session lifetime (Go duration).
SESSION_TTL=24h

# ---- invitations & password resets ----------------------------------------
# Lifetime of invitation and owner-issued password-reset links (10m-720h).
INVITE_TTL=72h
# Optional public web origin, no path (e.g. https://www.ecomacrobiz.com). When
# set AND an e-mail transport (RESEND_API_KEY or SMTP_HOST, plus SMTP_FROM /
# SMTP_TO) is configured, the API also e-mails the link
# <WEB_BASE_URL>/admin/invite#token=... to the invitee. Otherwise the owner
# copies the link from the admin UI (responses carry email_sent=false).
WEB_BASE_URL=

# ---- SEO: IndexNow (optional) ----------------------------------------------
# 8-128 characters of a-z A-Z 0-9 -. When set together with WEB_BASE_URL, the
# API submits changed post URLs (publish, update, unpublish, delete, scheduler)
# to https://api.indexnow.org/indexnow (async, 10 s timeout, log only). Set the
# SAME key as INDEXNOW_KEY on the web so it serves /<key>.txt. Empty = disabled.
INDEXNOW_KEY=

# ---- media ----------------------------------------------------------------
# Absolute public base used to build media URLs: <PUBLIC_BASE_URL>/media/<file>
PUBLIC_BASE_URL=http://localhost:18080
# Local directory for uploads (mount a persistent volume in production).
# Must be writable: the server refuses to start otherwise. Railway volumes are
# root-owned -> set RAILWAY_RUN_UID=0 on the api service (image runs as 65532).
MEDIA_DIR=./data/media
# Max upload size per file in MB (jpeg/png/webp/avif/gif only).
MAX_UPLOAD_MB=8
# Uploaded JPEG/PNG are downscaled so the longest side is at most this many
# pixels (320-10000), then re-encoded (strips EXIF/GPS). Images over 40
# megapixels are rejected. WebP: metadata stripped, not resized. GIF/AVIF as-is.
MEDIA_MAX_DIMENSION=2560

# ---- scheduled posts --------------------------------------------------------
# How often due scheduled posts are published (Go duration, min 5s). Also runs
# once at boot. Safe with several replicas (atomic UPDATE).
SCHEDULER_INTERVAL=60s

# ---- rate limits (events/window, Go duration) -----------------------------
# POST /api/v1/contact per client IP.
CONTACT_RATE_LIMIT=5/10m
# Admin login, applied separately per client IP and per email.
LOGIN_RATE_LIMIT=10/15m

# ---- lead notifications: email --------------------------------------------
# Two transports; RESEND_API_KEY wins when set. Both use SMTP_FROM + SMTP_TO.
#  a) Resend HTTPS API (https://resend.com) — use this on Railway Hobby, which
#     blocks outbound SMTP (SMTP needs Railway Pro). Verify the sender domain
#     in Resend first (adds DNS records; merge SPF into the ONE existing SPF TXT).
RESEND_API_KEY=
#  b) SMTP (Railway Pro and above, or local dev)
# Enabled when SMTP_HOST, SMTP_FROM and SMTP_TO are set. Port 587 uses
# STARTTLS (required for non-localhost hosts), 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# e.g. ECOMACROBIZ Website <no-reply@example.com>
SMTP_FROM=
# Comma-separated recipients, e.g. sales@example.com
SMTP_TO=

# ---- lead notifications: LINE Messaging API --------------------------------
# Push via https://api.line.me/v2/bot/message/push (LINE Notify is shut down).
# Channel access token (long-lived) from the LINE Developers console, and the
# user/group/room id to push to. Enabled when both are set.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# ---- web cache revalidation -----------------------------------------------
# After post create/update/delete the API POSTs {"tags":[...]} here with header
# x-revalidate-secret. Empty = disabled. Secret required when URL is set.
WEB_REVALIDATE_URL=http://localhost:3001/api/revalidate
REVALIDATE_SECRET=

# ---- admin bootstrap ------------------------------------------------------
# On boot (and via `server create-admin`) the admin is created (role owner)
# if missing. Password: 12-72 characters. An existing password is never
# overwritten unless ADMIN_RESET_PASSWORD=true, which is also the break-glass
# recovery: it restores role=owner + is_active=true for that account and
# revokes its sessions. Set it back to false after use.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_RESET_PASSWORD=false
